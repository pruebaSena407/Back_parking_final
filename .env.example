# =====================================================================
# Variables de entorno del backend (PostgreSQL)
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env a Git.
# =====================================================================

# URL completa de PostgreSQL (RECOMENDADO).
# Render entrega una URL parecida a:
#   postgres://usuario:contraseña@host:5432/dbname
# En config.py la normalizamos automáticamente a "postgresql://" para
# que SQLAlchemy 2.x la acepte.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombrebasedatos

# Clave secreta para firmar tokens JWT. Cambiar SIEMPRE en producción.
# Si no defines JWT_SECRET_KEY, se usa SECRET_KEY como respaldo.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Entorno de ejecución (opcional)
FLASK_ENV=production
